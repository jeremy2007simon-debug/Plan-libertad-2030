# Clave de la API de Anthropic. Es lo único imprescindible.
# El SDK la lee de aquí sin más configuración.
ANTHROPIC_API_KEY=sk-ant-...

# Tienda de la que el asistente lee las páginas de política en vivo.
SJW_TIENDA=https://5y82gi-yt.myshopify.com

# Dominio del escaparate, para el CORS. Con "*" responde a cualquiera:
# ponlo al dominio real antes de abrirlo al público.
SJW_ORIGEN=https://5y82gi-yt.myshopify.com
