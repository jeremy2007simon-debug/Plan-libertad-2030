{%- comment -%}
  Publica la ficha técnica de un producto para el motor de compatibilidad.

  Todos los valores salen de metafields. Si un metafield falta, el campo sale
  null y el motor deja el producto en "Necesita confirmación técnica".

  Valores por defecto prudentes cuando el metafield no está relleno:
    requiresManualVerification → true  (nunca se afirma compatibilidad)
    unitsPerSet                → ajuste del tema (4 por defecto)
    tiresIncluded / boltsIncluded → false

  Parámetros: product (obligatorio)
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom

  assign requires_verification = true
  if mf.requires_manual_verification.value == false
    assign requires_verification = false
  endif

  assign units = mf.units_per_set.value | default: settings.sjw_default_units_per_set | default: 4
-%}
<script type="application/json" class="sjw-fitment-data" data-product-id="{{ product.id }}">
{
  "productId": {{ product.id | json }},
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | default: '' | json }},
  "boltPattern": {{ mf.bolt_pattern.value | default: nil | json }},
  "diameter": {{ mf.wheel_diameter.value | default: nil | json }},
  "width": {{ mf.wheel_width.value | default: nil | json }},
  "et": {{ mf.offset_et.value | default: nil | json }},
  "etMin": {{ mf.offset_et_min.value | default: nil | json }},
  "etMax": {{ mf.offset_et_max.value | default: nil | json }},
  "centerBore": {{ mf.center_bore.value | default: nil | json }},
  "loadRating": {{ mf.load_rating.value | default: nil | json }},
  "finish": {{ mf.finish.value | default: nil | json }},
  "unitsPerSet": {{ units | json }},
  "tiresIncluded": {{ mf.tires_included.value | default: false | json }},
  "boltsIncluded": {{ mf.bolts_included.value | default: false | json }},
  "requiresManualVerification": {{ requires_verification | json }},
  "vehicleIds": [
    {%- for v in mf.compatible_vehicles.value -%}
      {{ v.system.id | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
