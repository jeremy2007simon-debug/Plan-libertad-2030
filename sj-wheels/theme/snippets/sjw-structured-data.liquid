{%- comment -%}
  SJ Wheels — Datos estructurados.

  Solo se declara lo que es cierto:
  · WebSite en todas las páginas, con la acción de búsqueda que existe.
  · BreadcrumbList cuando la página tiene una jerarquía real.
  · Product SOLO en la ficha de un producto, con lo que hay. Sin
    AggregateRating, sin reseñas y sin disponibilidad inventada: si el
    producto no está publicado, no se declara oferta.

  Revisión 20-09-2026: la oferta pide ahora DOS condiciones. Además de que
  el producto esté disponible, el tema tiene que estar mostrando precios
  (snippets/sjw-precio-modo.liquid). Con la escalera de precios pendiente de
  validación comercial, declarar un Offer con esa cifra sería publicar en
  Google un precio que SJ Wheels no ha confirmado, aunque la página diga
  «Precio bajo consulta».

  La Organization la emite la cabecera del tema, para no duplicarla.
{%- endcomment -%}
{%- liquid
  assign sjw_marca = settings.sjw_brand_name | default: shop.name
  assign inicio = request.origin | append: routes.root_url
-%}
{%- capture sjw_modo -%}{% render 'sjw-precio-modo' %}{%- endcapture -%}
{%- assign sjw_modo = sjw_modo | strip -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ sjw_marca | json }},
  "url": {{ inicio | json }},
  "inLanguage": {{ request.locale.iso_code | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      {%- comment -%}
        La plantilla de búsqueda lleva las llaves de schema.org fuera de
        cualquier etiqueta Liquid: dentro de una cadena Liquid, Shopify
        rechaza el archivo entero en silencio.
      {%- endcomment -%}
      "urlTemplate": "{{ request.origin }}{{ routes.search_url }}?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- liquid
  assign hay_miga = false
  if request.page_type == 'collection' and collection != blank
    assign hay_miga = true
    assign miga_nombre = collection.title
    assign miga_url = request.origin | append: collection.url
  elsif request.page_type == 'page' and page != blank
    assign hay_miga = true
    assign miga_nombre = page.title
    assign miga_url = request.origin | append: page.url
  elsif request.page_type == 'product' and product != blank
    assign hay_miga = true
    assign miga_nombre = product.title
    assign miga_url = request.origin | append: product.url
  endif
-%}
{%- if hay_miga -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'sjw.seo.home' | t | json }},
        "item": {{ inicio | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ miga_nombre | json }},
        "item": {{ miga_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product != blank -%}
  {%- liquid
    assign sku = product.selected_or_first_available_variant.sku | default: product.variants.first.sku
    assign diametro = product.metafields.custom.wheel_diameter.value
    assign pcd = product.metafields.custom.bolt_pattern.value

    assign declarar_oferta = false
    if product.available and sjw_modo == 'visible'
      assign declarar_oferta = true
    endif
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if sku != blank %}"sku": {{ sku | json }},{% endif %}
    {% if product.featured_image %}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
    {% if product.description != blank %}"description": {{ product.description | strip_html | truncate: 300 | json }},{% endif %}
    "brand": { "@type": "Brand", "name": {{ sjw_marca | json }} }
    {%- comment -%}
      La oferta solo se declara si el producto está realmente disponible en la
      tienda Y el tema muestra precios. Un producto que no se puede comprar, o
      cuyo precio está pendiente de validación, no se anuncia como comprable.
    {%- endcomment -%}
    {%- if declarar_oferta -%}
    ,"offers": {
      "@type": "Offer",
      "price": {{ product.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/InStock",
      "url": {{ request.origin | append: product.url | json }}
    }
    {%- endif -%}
    {%- if diametro != blank or pcd != blank -%}
    ,"additionalProperty": [
      {% if diametro != blank %}{ "@type": "PropertyValue", "name": "Diámetro", "value": {{ diametro | json }}, "unitText": "in" }{% if pcd != blank %},{% endif %}{% endif %}
      {% if pcd != blank %}{ "@type": "PropertyValue", "name": "PCD", "value": {{ pcd | json }} }{% endif %}
    ]
    {%- endif -%}
  }
  </script>
{%- endif -%}
