{%- comment -%}
  SJ Wheels — Botón «Solicitar precio y compatibilidad».

  Sustituye al botón de compra mientras la referencia no tenga precio
  validado ni compatibilidad confirmada. No es un botón oculto ni un adorno:
  la compra está bloqueada en los datos (inventario seguido, 0 unidades y
  política «dejar de vender»), y esto es solo la vía que sí existe para el
  cliente.

  Lleva la referencia ya cargada al formulario de
  /pages/solicitud-de-compatibilidad. El vehículo, si el cliente lo ha
  guardado, lo añade el propio formulario; el destino y el código postal los
  rellena allí.

  Revisión 21-09-2026 — catálogo agrupado por diseño: los datos que viajan
  al formulario son los de la variante elegida, no los de la familia. En
  SJW-048, por ejemplo, conviven 5x112 con buje 66,5 mm y 5x120 con buje
  72,6 mm: enviar «el anclaje del producto» sería enviar un dato falso. Se
  añade también el identificador de variante, para que la solicitud se
  pueda reconstruir exactamente.

  Parámetros:
    product : el producto (obligatorio)
    class   : clases extra para el enlace
{%- endcomment -%}
{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign mf = p.metafields.custom
  assign vmf = v.metafields.custom

  assign sku = v.sku | default: p.variants.first.sku

  assign d = vmf.wheel_diameter.value | default: mf.wheel_diameter.value
  assign w = vmf.wheel_width.value | default: mf.wheel_width.value
  assign pcd = vmf.bolt_pattern.value | default: mf.bolt_pattern.value
  assign et = vmf.offset_et.value | default: mf.offset_et.value
  assign buje = vmf.center_bore.value | default: mf.center_bore.value
  assign acabado = vmf.supplier_finish_code.value | default: mf.supplier_finish_code.value

  assign medida = ''
  if d != blank and w != blank
    assign medida = d | append: 'x' | append: w
  endif

  # Cada valor se codifica por separado. Codificar la cadena entera convertía
  # tambien los «?» y los «&», y el formulario recibia un unico parametro.
  assign q_producto = p.title | url_encode
  assign q_ref = sku | url_encode
  assign q_medida = medida | url_encode
  assign q_anclaje = pcd | url_encode
  assign q_et = et | url_encode
  assign q_buje = buje | url_encode
  assign q_acabado = acabado | url_encode

  assign destino = '/pages/solicitud-de-compatibilidad?producto=' | append: q_producto
  if sku != blank
    assign destino = destino | append: '&ref=' | append: q_ref
  endif
  if v.id != blank
    assign destino = destino | append: '&variante=' | append: v.id
  endif
  if medida != blank
    assign destino = destino | append: '&medida=' | append: q_medida
  endif
  if pcd != blank
    assign destino = destino | append: '&anclaje=' | append: q_anclaje
  endif
  if et != blank
    assign destino = destino | append: '&et=' | append: q_et
  endif
  if buje != blank
    assign destino = destino | append: '&buje=' | append: q_buje
  endif
  if acabado != blank
    assign destino = destino | append: '&acabado=' | append: q_acabado
  endif
-%}
<style>
  .sjw-precio-cta { display: grid; gap: .5rem; }
  .sjw-precio-cta__aviso { font-size: .8125rem; line-height: 1.45; opacity: .75; margin: 0; }
  .sjw-precio-cta__ref { font-size: .8125rem; line-height: 1.45; opacity: .75; margin: 0; }
</style>

<div class="sjw-precio-cta">
  <a
    class="button {{ class }}"
    href="{{ destino }}"
    data-sjw-solicitar-precio
    data-sjw-sku="{{ sku | escape }}"
    data-sjw-variante="{{ v.id }}"
  >{{ 'sjw.disponibilidad.cta' | t }}</a>

  {%- if sku != blank -%}
    <p class="sjw-precio-cta__ref">
      {{ 'sjw.variantes.envia_referencia' | t }} <strong>{{ sku }}</strong>
      {%- if v.title != blank and p.has_only_default_variant == false %} · {{ v.title }}{% endif -%}
    </p>
  {%- endif -%}

  <p class="sjw-precio-cta__aviso">{{ 'sjw.disponibilidad.aviso_compra' | t }}</p>
</div>

<script>
  /* Añade al enlace la cantidad y el vehículo guardado si existen, para que
     el formulario llegue con lo que el cliente ya ha elegido. Sin esto, el
     enlace sigue funcionando: los datos se piden en el propio formulario. */
  (function () {
    var enlaces = document.querySelectorAll('[data-sjw-solicitar-precio]');
    if (!enlaces.length) return;
    Array.prototype.forEach.call(enlaces, function (a) {
      a.addEventListener('click', function () {
        var url = new URL(a.href, location.origin);
        var qty = document.querySelector('input[name="quantity"]');
        if (qty && qty.value) url.searchParams.set('cantidad', qty.value);
        if (window.SJWGarage && window.SJWGarage.get) {
          var v = window.SJWGarage.get();
          if (v && window.SJWGarage.label) url.searchParams.set('vehiculo', window.SJWGarage.label(v));
        }
        a.href = url.pathname + url.search;
      });
    });
  })();
</script>
