{%- comment -%}
  Botón de WhatsApp con mensaje contextual.

  El número se configura en el personalizador. Si no hay número, no se pinta
  nada: no se inventa un contacto.

  Parámetros:
    context  'product' | 'cart' | 'no_results' | 'general'
    product  (opcional) para incluir nombre y referencia
    label    (opcional) texto del botón
    style    (opcional) 'primary' | 'secondary' | 'whatsapp' (por defecto)
    block    (opcional) true para ancho completo
{%- endcomment -%}
{%- liquid
  assign phone = settings.sjw_whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign style_class = style | default: 'whatsapp'
  assign btn_label = label | default: 'sjw.whatsapp.cta' | t
-%}
{%- if phone != blank -%}
  <a
    class="sjw-btn sjw-btn--{{ style_class }}{% if block %} sjw-btn--block{% endif %} sjw-whatsapp"
    data-sjw-whatsapp
    data-context="{{ context | default: 'general' }}"
    {% if product %}
      data-product-title="{{ product.title | escape }}"
      data-product-sku="{{ product.selected_or_first_available_variant.sku | escape }}"
    {% endif %}
    data-phone="{{ phone }}"
    href="https://wa.me/{{ phone }}"
    target="_blank"
    rel="noopener"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 004.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.24 8.24 0 01-1.26-4.38c0-4.55 3.7-8.25 8.25-8.25 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 012.41 5.84c0 4.55-3.7 8.25-8.26 8.25zm4.53-6.18c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.1-.5.11-.11.25-.29.37-.44.13-.14.17-.24.25-.41.09-.16.04-.3-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.47c-.16 0-.43.06-.65.3-.23.25-.86.85-.86 2.07 0 1.21.88 2.39 1.01 2.55.12.17 1.73 2.64 4.19 3.7.59.26 1.04.4 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.46-.6 1.67-1.18.2-.57.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29z"/>
    </svg>
    <span>{{ btn_label }}</span>
  </a>
{%- endif -%}
