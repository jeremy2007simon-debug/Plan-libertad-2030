{% doc %}
  Selects a complete configuration and reloads its canonical variant URL.
  @param {object} product_resource - The product.
  @param {object} [block] - The editor block.
  @param {object} section - The section.
{% enddoc %}
{% unless product_resource.has_only_default_variant %}
  <div class="sjw-configuration" {{ block.shopify_attributes }}>
    <form method="get" action="{{ product_resource.url }}">
      <label for="SJW-Variant-{{ section.id }}-{{ block.id }}">{{ 'sjw.variantes.elegir' | t }}</label>
      <p id="SJW-Help-{{ section.id }}-{{ block.id }}" class="sjw-small">{{ 'sjw.variantes.ayuda' | t }}</p>
      <select id="SJW-Variant-{{ section.id }}-{{ block.id }}" name="variant" aria-describedby="SJW-Help-{{ section.id }}-{{ block.id }}" onchange="this.form.requestSubmit()">
        {% for variant in product_resource.variants %}
          <option value="{{ variant.id }}" {% if variant.id == product_resource.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title | escape }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="sjw-btn sjw-btn--secondary sjw-btn--sm">{{ 'sjw.variantes.aplicar' | t }}</button>
    </form>
  </div>
{% endunless %}
{% stylesheet %}
  .sjw-configuration { min-width:0; width:100%; }
  .sjw-configuration form { display:grid; gap:12px; min-width:0; }
  .sjw-configuration label { font-weight:600; }
  .sjw-configuration p { margin:0; }
  .sjw-configuration select { width:100%; min-width:0; max-width:100%; min-height:48px; padding:12px 32px 12px 12px; border:1px solid #656a74; border-radius:8px; background:#17191e; color:#f5f5f2; font:inherit; font-size:14px; }
  .sjw-configuration button { justify-self:start; }
  .sjw-configuration select:focus-visible { outline:2px solid #ff5a1f; outline-offset:3px; }
{% endstylesheet %}
