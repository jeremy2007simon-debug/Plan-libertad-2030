{%- comment -%}
  SJ Wheels — Comparador. Botón flotante y panel lateral.
  Se coloca una vez por plantilla (colección, búsqueda, producto).
{%- endcomment -%}
{%- if settings.sjw_enable_compare -%}
{%- comment -%}
  Los estilos van antes del marcado: con la hoja al final, el navegador puede
  llegar a pintar la sección sin ella y la página da un salto cuando aparece.
  Medido en la solicitud de compatibilidad: 36 px de desplazamiento (CLS 0,138).
{%- endcomment -%}
<style>
  .sjw-cmp-fab { position: fixed; inset: auto var(--sjw-s4) var(--sjw-s4) auto;
                 z-index: var(--sjw-z-sticky); box-shadow: var(--sjw-shadow-md); }
  @media (max-width: 749px) { .sjw-cmp-fab { inset: auto var(--sjw-s4) calc(var(--sjw-s4) + 64px) auto; } }
  .sjw-cmp-panel { width: min(680px, 100%); }
  .sjw-cmp { width: 100%; border-collapse: collapse; font-size: .8125rem; }
  .sjw-cmp th, .sjw-cmp td { padding: var(--sjw-s2) var(--sjw-s3); text-align: left;
                             border-bottom: var(--sjw-border); vertical-align: top; }
  .sjw-cmp tbody th { color: var(--sjw-text-muted); font-weight: 500; white-space: nowrap; }
  .sjw-cmp td { font-variant-numeric: tabular-nums; }
  .sjw-cmp tr.is-diff td { color: var(--sjw-warm-white); font-weight: 600; }
  .sjw-cmp tr.is-diff th { color: var(--sjw-orange); }
  .sjw-cmp__head { display: grid; gap: var(--sjw-s2); justify-items: start; min-width: 9rem; }
  .sjw-cmp__head img { width: 96px; height: 96px; object-fit: contain; background: var(--sjw-metal);
                       border-radius: var(--sjw-r-sm); }
  .sjw-cmp__title { font-size: .8125rem; font-weight: 600; line-height: 1.3; }
</style>

<div class="sjw-root" data-sjw-compare-max="{{ settings.sjw_compare_max | default: 3 }}">

  <button type="button" class="sjw-btn sjw-btn--primary sjw-cmp-fab" data-sjw-compare-open hidden>
    {{ 'sjw.compare.open' | t }}
    <span class="sjw-badge sjw-badge--neutral" data-sjw-compare-count>0</span>
  </button>

  <div class="sjw-overlay" data-sjw-compare-overlay></div>

  <aside class="sjw-drawer sjw-cmp-panel" data-sjw-compare-panel hidden
         role="dialog" aria-modal="true" aria-labelledby="sjw-cmp-title">
    <header class="sjw-drawer__head">
      <h2 class="sjw-h3" id="sjw-cmp-title">{{ 'sjw.compare.title' | t }}</h2>
      <button type="button" class="sjw-btn-icon" data-sjw-compare-close aria-label="{{ 'sjw.compare.close' | t }}">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="sjw-drawer__body" data-sjw-compare-body></div>

    <footer class="sjw-drawer__foot sjw-row">
      <button type="button" class="sjw-btn sjw-btn--ghost sjw-btn--sm" data-sjw-compare-clear>
        {{ 'sjw.compare.clear' | t }}
      </button>
      <span class="sjw-small">{{ 'sjw.fitment.final_check' | t }}</span>
    </footer>
  </aside>
</div>


<script src="{{ 'sjw-compare.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Comparador",
  "tag": "div",
  "settings": [],
  "presets": [{ "name": "Comparador" }]
}
{% endschema %}
