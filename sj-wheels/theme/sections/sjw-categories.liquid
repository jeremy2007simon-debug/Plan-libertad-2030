{%- comment -%}
  SJ Wheels — Categorías. Solo enlaza a colecciones con productos visibles.
  Si no hay ninguna, no se deja un título con un hueco debajo: se explica por
  qué está vacío y se ofrece la vía que sí funciona.
{%- endcomment -%}
{%- liquid
  assign visibles = 0
  for block in section.blocks
    assign col = collections[block.settings.collection]
    if col != blank and col.products_count > 0
      assign visibles = visibles | plus: 1
    endif
  endfor
-%}
<section class="sjw-root sjw-section" style="background: {{ section.settings.background_color }};">
  <div class="sjw-container">
    <div class="sjw-cats__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sjw-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sjw-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- capture link_destino -%}{% render 'sjw-url', ruta: section.settings.link_url %}{%- endcapture -%}
      {%- if visibles > 0 and link_destino != blank and section.settings.link_label != blank -%}
        <a class="sjw-btn sjw-btn--ghost sjw-btn--sm" href="{{ link_destino }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if visibles == 0 -%}
      <div class="sjw-note sjw-note--info sjw-cats__vacio">
        {% render 'sjw-icono', nombre: 'info' %}
        <div>
          <strong>{{ 'sjw.collection.catalog_pending_title' | t }}</strong>
          <p class="sjw-small">{{ 'sjw.collection.catalog_pending_body' | t }}</p>
          <p class="sjw-cats__accion">
            {%- capture u_pages_solicitud_de_compatibilidad -%}{% render 'sjw-url', ruta: '/pages/solicitud-de-compatibilidad' %}{%- endcapture -%}
            <a class="sjw-btn sjw-btn--primary sjw-btn--sm" href="{{ u_pages_solicitud_de_compatibilidad }}">
              {{ 'sjw.collection.catalog_pending_cta' | t }}
            </a>
          </p>
        </div>
      </div>
    {%- endif -%}

    <ul class="sjw-cats" role="list">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- if col != blank and col.products_count > 0 -%}
          <li {{ block.shopify_attributes }}>
            <a class="sjw-card sjw-card--interactive sjw-cat" href="{{ col.url }}">
              {%- if col.featured_image -%}
                <img class="sjw-cat__img"
                     src="{{ col.featured_image | image_url: width: 480 }}"
                     srcset="{{ col.featured_image | image_url: width: 320 }} 320w, {{ col.featured_image | image_url: width: 640 }} 640w"
                     sizes="(min-width: 1000px) 25vw, 45vw"
                     width="480" height="360" loading="lazy" decoding="async"
                     alt="{{ col.featured_image.alt | default: col.title | escape }}">
              {%- else -%}
                <span class="sjw-cat__img sjw-cat__img--empty sjw-grid-bg" aria-hidden="true"></span>
              {%- endif -%}
              <span class="sjw-cat__body">
                <span class="sjw-cat__title">{{ block.settings.title | default: col.title }}</span>
                <span class="sjw-small">{{ col.products_count }} {{ 'sjw.collection.results' | t }}</span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .sjw-cats__head { display: flex; flex-wrap: wrap; gap: var(--sjw-s3); align-items: flex-end;
                    justify-content: space-between; margin-bottom: var(--sjw-s5); }
  .sjw-cats { display: grid; gap: var(--sjw-s3); margin: 0; padding: 0; list-style: none;
              grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 800px)  { .sjw-cats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .sjw-cat { display: grid; grid-template-columns: minmax(0, 1fr); text-decoration: none; color: inherit; }
  .sjw-cat__img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--sjw-metal); }
  .sjw-cat__img--empty { aspect-ratio: 4 / 3; }
  .sjw-cat__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; padding: var(--sjw-s3) var(--sjw-s4) var(--sjw-s4); }
  .sjw-cat__title { font-weight: 600; font-size: .9375rem; }
  .sjw-cats__vacio { margin-top: var(--sjw-s4); }
  .sjw-cats__accion { margin: var(--sjw-s3) 0 0; }
  .sjw-cats:empty { display: none; }
</style>

{% schema %}
{
  "name": "Categorías",
  "tag": "section",
  "blocks": [
    { "type": "category", "name": "Categoría", "settings": [
      { "type": "collection", "id": "collection", "label": "Colección" },
      { "type": "text", "id": "title", "label": "Título (opcional)", "info": "Si lo dejas vacío se usa el nombre de la colección." }
    ]}
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Catálogo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Comprar por diámetro" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todo" },
    { "type": "url", "id": "link_url", "label": "Enlace" },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#090A0C" }
  ],
  "presets": [{ "name": "Categorías", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
