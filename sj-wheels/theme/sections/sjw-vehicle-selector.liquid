{%- comment -%}
  SJ Wheels — Buscador por vehículo.
  Es la función principal de la tienda. Editable desde el personalizador.
{%- endcomment -%}

{% render 'sjw-vehicle-catalog' %}

{%- liquid
  assign wa_label = 'sjw.selector.empty_cta' | t
  # Cuántos vehículos verificados hay. Se decide en el servidor: si no hay
  # ninguno, el formulario no se llega a pintar. Antes dependía de JavaScript
  # y el cliente veía un instante los desplegables vacíos, o los veía siempre
  # si el script tardaba o fallaba.
  assign hay_vehiculos = shop.metaobjects.vehicle.values.size
-%}

{%- comment -%}
  El id es el destino de los enlaces "#sjw-vehicle-picker" que hay en la barra
  de vehículo y en la ficha de producto. Sin él, esos enlaces no llevaban a
  ninguna parte.
{%- endcomment -%}
<section
  id="sjw-vehicle-picker"
  class="sjw-root sjw-section"
  style="background: {{ section.settings.background_color }};"
  aria-labelledby="sjw-selector-title-{{ section.id }}"
>
  <div class="sjw-container">
    <div class="sjw-selector{% if section.settings.compact %} sjw-selector--compact{% endif %}">

      {%- if section.settings.eyebrow != blank -%}
        <p class="sjw-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="sjw-h2" id="sjw-selector-title-{{ section.id }}">{{ section.settings.heading }}</h2>

      {%- comment -%}
        Con buscador, el texto de apoyo es el del personalizador. Sin vehículos
        cargados, lo escribe el tema: así no se repite tres veces que la base
        está vacía, que era lo que veía el cliente.
      {%- endcomment -%}
      {%- if hay_vehiculos > 0 -%}
        {%- if section.settings.subheading != blank -%}
          <p class="sjw-lead sjw-selector__lead">{{ section.settings.subheading }}</p>
        {%- endif -%}
      {%- else -%}
        <p class="sjw-lead sjw-selector__lead">{{ 'sjw.consulta.lead' | t }}</p>
      {%- endif -%}

      <sjw-vehicle-selector
        class="sjw-selector__widget"
        {% if section.settings.redirect_url != blank %}data-redirect="{{ section.settings.redirect_url }}"{% endif %}
      >
        {%- if hay_vehiculos > 0 -%}
        <form data-sjw-selector-form class="sjw-selector__form" novalidate>
          <div class="sjw-selector__grid">
            {%- assign steps = 'make,model,generation,year,engine' | split: ',' -%}
            {%- for step in steps -%}
              {%- liquid
                assign key = 'sjw.selector.' | append: step
                assign lbl = key | t
              -%}
              <div class="sjw-field" data-sjw-step-wrapper hidden>
                <label class="sjw-label" for="sjw-{{ step }}-{{ section.id }}">{{ lbl }}</label>
                <select
                  class="sjw-select"
                  id="sjw-{{ step }}-{{ section.id }}"
                  data-step="{{ step }}"
                  data-placeholder="{{ lbl }}"
                >
                  <option value="">{{ lbl }}</option>
                </select>
              </div>
            {%- endfor -%}
          </div>

          <div class="sjw-selector__actions">
            <button type="submit" class="sjw-btn sjw-btn--primary" data-sjw-selector-submit disabled aria-disabled="true">
              {{ section.settings.cta_label | default: 'Buscar llantas compatibles' }}
            </button>
            <button type="button" class="sjw-btn sjw-btn--ghost sjw-btn--sm" data-sjw-selector-reset hidden>
              {{ 'sjw.selector.reset' | t }}
            </button>
          </div>

          <p class="sjw-small sjw-selector__disclaimer">{{ 'sjw.fitment.final_check' | t }}</p>
          <p class="sjw-visually-hidden" role="status" aria-live="polite" data-sjw-selector-status></p>
        </form>
        {%- endif -%}

        {%- comment -%}
          Sin vehículos verificados no hay buscador que enseñar, así que en su
          lugar se explica el recorrido real de la consulta manual. Un solo
          mensaje y una sola llamada a la acción.
        {%- endcomment -%}
        <div class="sjw-consulta" data-sjw-selector-empty {% if hay_vehiculos > 0 %}hidden{% endif %}>
          <ol class="sjw-consulta__pasos" role="list">
            {%- assign pasos = 'paso1,paso2,paso3,paso4' | split: ',' -%}
            {%- for paso in pasos -%}
              {%- liquid
                assign k_title = 'sjw.consulta.' | append: paso | append: '_title'
                assign k_body  = 'sjw.consulta.' | append: paso | append: '_body'
              -%}
              <li class="sjw-consulta__paso">
                <span class="sjw-consulta__n" aria-hidden="true">{{ forloop.index }}</span>
                <span class="sjw-consulta__texto">
                  <span class="sjw-consulta__title">{{ k_title | t }}</span>
                  <span class="sjw-consulta__body">{{ k_body | t }}</span>
                </span>
              </li>
            {%- endfor -%}
          </ol>

          <div class="sjw-consulta__acciones">
            {%- capture u_pages_solicitud_de_compatibilidad -%}{% render 'sjw-url', ruta: '/pages/solicitud-de-compatibilidad' %}{%- endcapture -%}
            <a class="sjw-btn sjw-btn--primary" href="{{ u_pages_solicitud_de_compatibilidad }}">
              {{ 'sjw.consulta.cta' | t }}
            </a>
            {%- capture u_pages_guia_de_medidas -%}{% render 'sjw-url', ruta: '/pages/guia-de-medidas' %}{%- endcapture -%}
            <a class="sjw-btn sjw-btn--secondary" href="{{ u_pages_guia_de_medidas }}">
              {{ 'sjw.consulta.alt' | t }}
            </a>
            {%- comment -%}
              El botón de WhatsApp solo aparece si hay número configurado: el
              propio snippet no pinta nada cuando falta.
            {%- endcomment -%}
            {% render 'sjw-whatsapp', context: 'no_results', label: wa_label %}
          </div>
        </div>
      </sjw-vehicle-selector>

      {%- comment -%} Vehículo ya guardado. {%- endcomment -%}
      <div class="sjw-selector__saved sjw-note sjw-note--info" data-sjw-has-vehicle hidden>
        {% render 'sjw-icono', nombre: 'vehiculo' %}
        <span>{{ 'sjw.selector.your_vehicle' | t }}: <strong data-sjw-vehicle-label></strong></span>
      </div>

    </div>
  </div>
</section>

<style>
  .sjw-selector { display: grid; gap: var(--sjw-s4); max-width: 68rem; }
  .sjw-selector__lead { max-width: 46rem; }
  .sjw-selector__widget { display: block; }
  .sjw-selector__form { display: grid; gap: var(--sjw-s4); }
  .sjw-selector__grid { display: grid; gap: var(--sjw-s3); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px)  { .sjw-selector__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .sjw-selector__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .sjw-selector__actions { display: flex; flex-wrap: wrap; gap: var(--sjw-s3); align-items: center; }
  .sjw-selector__actions .sjw-btn--primary { flex: 1 1 16rem; }
  .sjw-selector__disclaimer { margin: 0; }
  .sjw-selector--compact { gap: var(--sjw-s3); }

  /* Consulta guiada: cuatro pasos, sin caja de "no hay nada". */
  .sjw-consulta { display: grid; gap: var(--sjw-s5); }
  .sjw-consulta__pasos {
    display: grid; gap: var(--sjw-s4);
    grid-template-columns: minmax(0, 1fr);
    margin: 0; padding: 0; list-style: none;
    counter-reset: none;
  }
  @media (min-width: 720px)  { .sjw-consulta__pasos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { .sjw-consulta__pasos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .sjw-consulta__paso {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--sjw-s3);
    align-items: start;
    padding-top: var(--sjw-s4);
    border-top: 2px solid var(--sjw-metal);
  }
  .sjw-consulta__n {
    display: grid; place-items: center;
    width: 1.75rem; height: 1.75rem;
    border-radius: var(--sjw-r-pill);
    background: var(--sjw-orange-soft); color: var(--sjw-orange);
    font-size: .8125rem; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .sjw-consulta__texto { display: grid; gap: var(--sjw-s1); }
  .sjw-consulta__title { font-size: .9375rem; font-weight: 700; color: var(--sjw-warm-white); }
  .sjw-consulta__body  { font-size: .875rem; line-height: 1.55; color: var(--sjw-text-muted); }
  .sjw-consulta__acciones { display: flex; flex-wrap: wrap; gap: var(--sjw-s3); }
</style>

<script src="{{ 'sjw-selector.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Buscador por vehículo",
  "tag": "section",
  "class": "sjw-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Compatibilidad revisada" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Las llantas que encajan con tu coche" },
    { "type": "textarea", "id": "subheading", "label": "Texto de apoyo",
      "default": "Selecciona tu vehículo y descubre diseños compatibles con sus medidas técnicas." },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Buscar llantas compatibles" },
    { "type": "url", "id": "redirect_url", "label": "Ir a esta página tras elegir el vehículo",
      "info": "Déjalo vacío para quedarse en la misma página." },
    { "type": "checkbox", "id": "compact", "label": "Versión compacta", "default": false },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#121418" }
  ],
  "presets": [{ "name": "Buscador por vehículo" }]
}
{% endschema %}
