{%- comment -%}
  SJ Wheels — Solicitud manual de compatibilidad.

  Mientras no haya vehículos verificados en la base, TODO el catálogo está en
  "Necesita confirmación técnica" y esta es la única vía real del cliente.
  Por eso el formulario no puede depender de WhatsApp ni de ninguna app: usa
  {% form 'contact' %}, que es nativo de Shopify y funciona sin instalar nada.

  El texto no promete una comprobación que no se hace: la revisión técnica es
  de una persona y no se limita a PCD, diámetro, ET y buje.

  Revisión 20-09-2026: el formulario recoge ahora lo que hace falta para
  responder a una solicitud de precio desde una ficha: producto, referencia
  (SKU), medida, acabado solicitado, unidades, destino y código postal,
  además del vehículo. Lo que llega en la URL desde la ficha se rellena solo;
  lo demás lo escribe el cliente. El destino y el código postal se piden
  porque el transporte todavía no está cerrado y la respuesta depende del
  territorio.
{%- endcomment -%}

{% render 'sjw-strings' %}

{%- liquid
  assign titulo = section.settings.heading
  assign intro  = section.settings.intro
-%}

{%- comment -%}
  Los estilos van ANTES del marcado a propósito. Con la hoja al final, el
  navegador llegaba a pintar la introducción sin la rejilla y luego aparecían
  las separaciones: la página daba un salto de 36 px (CLS 0,138 medido en
  móvil). Puestos delante, el primer pintado ya es el definitivo.
{%- endcomment -%}
<style>
  .sjw-req { display: grid; gap: var(--sjw-s6); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 900px) { .sjw-req { grid-template-columns: 22rem minmax(0, 1fr); gap: var(--sjw-s7); } }
  .sjw-req__intro { display: grid; gap: var(--sjw-s3); }
  .sjw-req__form { display: grid; gap: var(--sjw-s4); }
  .sjw-req__grid { display: grid; gap: var(--sjw-s3); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .sjw-req__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sjw-req__wide { grid-column: 1 / -1; }
  .sjw-req__area { min-height: 7rem; padding-block: var(--sjw-s3); resize: vertical; }
  .sjw-req__actions { display: flex; flex-wrap: wrap; gap: var(--sjw-s3); align-items: center; }
  .sjw-req__marca {
    margin-inline-start: .5ch;
    font-size: .6875rem; font-weight: 500; letter-spacing: .04em;
    text-transform: lowercase; color: var(--sjw-orange);
  }
  .sjw-req__marca--opcional { color: var(--sjw-text-faint); }
  .sjw-req__sep { grid-column: 1 / -1; margin: var(--sjw-s2) 0 0; font-size: .8125rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; opacity: .7; }
</style>

<section class="sjw-root sjw-section" style="background: {{ section.settings.background_color }};">
  <div class="sjw-container sjw-req">
    <div class="sjw-req__intro">
      <p class="sjw-eyebrow">{{ 'sjw.request.eyebrow' | t }}</p>
      {%- if section.settings.usar_h1 -%}
        <h1 class="sjw-h2">{{ titulo }}</h1>
      {%- else -%}
        <h2 class="sjw-h2">{{ titulo }}</h2>
      {%- endif -%}
      {% if intro != blank %}<p class="sjw-lead">{{ intro }}</p>{% endif %}

      <div class="sjw-note sjw-note--info">
        {% render 'sjw-icono', nombre: 'info' %}
        <div>
          <strong>{{ 'sjw.request.what_we_check' | t }}</strong>
          <p class="sjw-small">{{ 'sjw.request.what_we_check_body' | t }}</p>
        </div>
      </div>
    </div>

    {% form 'contact', class: 'sjw-req__form', id: 'sjw-fitment-request' %}
      {%- comment -%}
        Marca de "enviado" para el script. Un atributo con guion dentro de la
        etiqueta `form` es terreno resbaladizo en Liquid, así que va como
        elemento propio.
      {%- endcomment -%}
      {%- if form.posted_successfully? -%}<span data-sjw-req-enviado hidden></span>{%- endif -%}
      {%- if form.posted_successfully? -%}
        <div class="sjw-note sjw-note--ok" role="status" tabindex="-1" data-sjw-req-ok>
          {% render 'sjw-icono', nombre: 'ok' %}
          <div>
            <strong>{{ 'sjw.request.sent_title' | t }}</strong>
            <p class="sjw-small">{{ 'sjw.request.sent_body' | t }}</p>
          </div>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="sjw-note sjw-note--error" role="alert" tabindex="-1" data-sjw-req-error>
          {% render 'sjw-icono', nombre: 'error' %}
          <div>
            <strong>{{ 'sjw.request.error_title' | t }}</strong>
            <ul class="sjw-small">
              {%- for campo in form.errors -%}
                <li>{{ form.errors.messages[campo] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      <div class="sjw-req__grid">
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-nombre">
            {{ 'sjw.request.name' | t }}
            <span class="sjw-req__marca">{{ 'sjw.request.required' | t }}</span>
          </label>
          <input class="sjw-input" id="sjw-req-nombre" type="text" name="contact[name]"
                 autocomplete="name" required aria-required="true"
                 {% if form.errors contains 'name' %}aria-invalid="true"{% endif %}
                 value="{{ form.name }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-email">
            {{ 'sjw.request.email' | t }}
            <span class="sjw-req__marca">{{ 'sjw.request.required' | t }}</span>
          </label>
          <input class="sjw-input" id="sjw-req-email" type="email" name="contact[email]"
                 autocomplete="email" required aria-required="true"
                 {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
                 value="{{ form.email }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-tel">
            {{ 'sjw.request.phone' | t }}
            <span class="sjw-req__marca sjw-req__marca--opcional">{{ 'sjw.request.optional' | t }}</span>
          </label>
          <input class="sjw-input" id="sjw-req-tel" type="tel" name="contact[phone]"
                 autocomplete="tel" inputmode="tel"
                 aria-describedby="sjw-req-tel-ayuda"
                 placeholder="{{ 'sjw.request.phone_ph' | t }}">
          <span class="sjw-small" id="sjw-req-tel-ayuda">{{ 'sjw.request.phone_help' | t }}</span>
        </p>
        {%- if section.settings.mostrar_motivo -%}
          <p class="sjw-field sjw-req__wide">
            <label class="sjw-label" for="sjw-req-motivo">{{ 'sjw.request.reason' | t }}</label>
            <select class="sjw-select" id="sjw-req-motivo" name="contact[Motivo de la consulta]" required>
              <option value="">{{ 'sjw.request.reason_pick' | t }}</option>
              <option>{{ 'sjw.request.reason_fitment' | t }}</option>
              <option>{{ 'sjw.request.reason_order' | t }}</option>
              <option>{{ 'sjw.request.reason_shipping' | t }}</option>
              <option>{{ 'sjw.request.reason_return' | t }}</option>
              <option>{{ 'sjw.request.reason_other' | t }}</option>
            </select>
          </p>
        {%- endif -%}

        <p class="sjw-req__sep">Tu vehículo</p>

        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-marca">{{ 'sjw.request.make_model' | t }}</label>
          <input class="sjw-input" id="sjw-req-marca" type="text"{% unless section.settings.mostrar_motivo %} required{% endunless %}
                 name="contact[Marca, modelo y generación]"
                 placeholder="{{ 'sjw.request.make_model_ph' | t }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-anio">{{ 'sjw.request.year' | t }}</label>
          <input class="sjw-input" id="sjw-req-anio" type="text" inputmode="numeric"{% unless section.settings.mostrar_motivo %} required{% endunless %}
                 name="contact[Año de matriculación]" placeholder="2019">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-motor">{{ 'sjw.request.engine' | t }}</label>
          <input class="sjw-input" id="sjw-req-motor" type="text"
                 name="contact[Motorización o versión]" placeholder="{{ 'sjw.request.engine_ph' | t }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-actual">{{ 'sjw.request.current_size' | t }}</label>
          <input class="sjw-input" id="sjw-req-actual" type="text"
                 name="contact[Medida montada actualmente]" placeholder="{{ 'sjw.request.current_size_ph' | t }}">
        </p>

        {%- comment -%}
          Bloque de la referencia. Todo lo que viene de la ficha se rellena
          solo desde la URL, pero los campos quedan a la vista y editables:
          el cliente tiene que poder corregir lo que se ha cargado.
        {%- endcomment -%}
        <p class="sjw-req__sep">La llanta que te interesa</p>

        <p class="sjw-field sjw-req__wide">
          <label class="sjw-label" for="sjw-req-producto">Producto</label>
          <input class="sjw-input" id="sjw-req-producto" type="text"
                 name="contact[Producto]" data-sjw-req-param="producto"
                 placeholder="Nombre del diseño, por ejemplo SJW-074">
        </p>
        <p class="sjw-field sjw-req__wide">
          <label class="sjw-label" for="sjw-req-ref">{{ 'sjw.request.reference' | t }}</label>
          <input class="sjw-input" id="sjw-req-ref" type="text"
                 name="contact[Referencia de la llanta]" data-sjw-req-reference data-sjw-req-param="ref"
                 aria-describedby="sjw-req-ref-ayuda"
                 placeholder="{{ 'sjw.request.reference_ph' | t }}">
          <span class="sjw-small" id="sjw-req-ref-ayuda">{{ 'sjw.request.reference_help' | t }}</span>
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-medida">Medida solicitada</label>
          <input class="sjw-input" id="sjw-req-medida" type="text"
                 name="contact[Medida solicitada]" data-sjw-req-param="medida"
                 placeholder="20x9.5">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-anclaje">Anclaje (PCD)</label>
          <input class="sjw-input" id="sjw-req-anclaje" type="text"
                 name="contact[Anclaje solicitado]" data-sjw-req-param="anclaje"
                 placeholder="5x112">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-acabado">Acabado solicitado</label>
          <input class="sjw-input" id="sjw-req-acabado" type="text"
                 name="contact[Acabado solicitado]" data-sjw-req-param="acabado"
                 aria-describedby="sjw-req-acabado-ayuda"
                 placeholder="Código del proveedor, por ejemplo MB">
          <span class="sjw-small" id="sjw-req-acabado-ayuda">SJ Wheels todavía no tiene la carta de colores: el acabado se identifica por el código del proveedor.</span>
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-cantidad">Unidades</label>
          <input class="sjw-input" id="sjw-req-cantidad" type="number" min="1" step="1" inputmode="numeric"
                 name="contact[Unidades solicitadas]" data-sjw-req-param="cantidad"
                 aria-describedby="sjw-req-cantidad-ayuda"
                 placeholder="4">
          <span class="sjw-small" id="sjw-req-cantidad-ayuda">Dinos cuántas llantas necesitas. El contenido del pedido todavía no está documentado por el proveedor.</span>
        </p>

        <p class="sjw-req__sep">Dónde lo quieres recibir</p>

        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-destino">
            Destino del envío
            <span class="sjw-req__marca">{{ 'sjw.request.required' | t }}</span>
          </label>
          <select class="sjw-select" id="sjw-req-destino" name="contact[Destino del envío]"
                  data-sjw-req-param="destino" required aria-required="true">
            <option value="">Selecciona el destino</option>
            <option>Península</option>
            <option>Baleares</option>
            <option>Canarias</option>
            <option>Ceuta</option>
            <option>Melilla</option>
            <option>Otro país</option>
          </select>
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-cp">
            Código postal
            <span class="sjw-req__marca">{{ 'sjw.request.required' | t }}</span>
          </label>
          <input class="sjw-input" id="sjw-req-cp" type="text" inputmode="numeric"
                 autocomplete="postal-code" name="contact[Código postal]"
                 data-sjw-req-param="cp" required aria-required="true"
                 aria-describedby="sjw-req-cp-ayuda" placeholder="28001">
          <span class="sjw-small" id="sjw-req-cp-ayuda">El transporte y los impuestos dependen del territorio, así que el código postal es necesario para darte un precio.</span>
        </p>

        <p class="sjw-field sjw-req__wide">
          <label class="sjw-label" for="sjw-req-msg">{{ 'sjw.request.message' | t }}</label>
          <textarea class="sjw-input sjw-req__area" id="sjw-req-msg" rows="4"
                    name="contact[body]"
                    {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
                    placeholder="{{ 'sjw.request.message_ph' | t }}">{{ form.body }}</textarea>
        </p>
      </div>

      {%- comment -%}
        Lo que el navegador sabe del vehículo guardado se envía como dato de
        apoyo, marcado como indicado por el cliente. No es una verificación.
      {%- endcomment -%}
      <input type="hidden" name="contact[Vehículo guardado en la web (indicado por el cliente)]"
             data-sjw-req-vehicle value="">

      <p class="sjw-form-msg sjw-form-msg--info" data-sjw-req-restaurado hidden role="status">
        {% render 'sjw-icono', nombre: 'info' %}
        <span>{{ 'sjw.request.restored' | t }}</span>
      </p>

      <div class="sjw-req__actions">
        <button class="sjw-btn sjw-btn--primary" type="submit">{{ 'sjw.request.submit' | t }}</button>
        <span class="sjw-small">{{ 'sjw.request.privacy' | t }}</span>
      </div>
    {% endform %}
  </div>
</section>

<script>
  /* Tres cosas, todas del lado del cliente:
     1) rellena lo que llega en la URL desde la ficha (producto, referencia,
        medida, anclaje, acabado, unidades) y el vehículo guardado en el garaje;
     2) guarda lo escrito mientras se escribe;
     3) si el envío vuelve con error, devuelve el texto a su sitio.

     Shopify solo repone en Liquid los campos que conoce (nombre, correo,
     cuerpo). Los del vehículo son campos propios y se perdían enteros: el
     cliente tenía que volver a escribirlo todo. Esto lo evita. Se usa
     sessionStorage, que muere al cerrar la pestaña y no sale del navegador. */
  (function () {
    var form = document.getElementById('sjw-fitment-request');
    if (!form) return;

    var CLAVE = 'sjw_solicitud_v1';
    var enviado = !!form.querySelector('[data-sjw-req-enviado]');

    function almacen() {
      try { return window.sessionStorage; } catch (e) { return null; }
    }

    function campos() {
      return Array.prototype.filter.call(
        form.querySelectorAll('input[name], select[name], textarea[name]'),
        function (el) { return el.type !== 'hidden' && el.type !== 'submit'; }
      );
    }

    function guardar() {
      var caja = almacen();
      if (!caja) return;
      var datos = {};
      campos().forEach(function (el) { if (el.value) datos[el.name] = el.value; });
      try { caja.setItem(CLAVE, JSON.stringify(datos)); } catch (e) { /* cuota llena */ }
    }

    function limpiar() {
      var caja = almacen();
      if (!caja) return;
      try { caja.removeItem(CLAVE); } catch (e) { /* nada que hacer */ }
    }

    function restaurar() {
      var caja = almacen();
      if (!caja) return false;
      var crudo;
      try { crudo = caja.getItem(CLAVE); } catch (e) { return false; }
      if (!crudo) return false;
      var datos;
      try { datos = JSON.parse(crudo); } catch (e) { limpiar(); return false; }
      var repuesto = false;
      campos().forEach(function (el) {
        if (!el.value && datos[el.name]) { el.value = datos[el.name]; repuesto = true; }
      });
      return repuesto;
    }

    /* Lo que llega desde la ficha de producto. Cada campo declara en
       data-sjw-req-param el parámetro de la URL que le corresponde, así que
       añadir uno nuevo no obliga a tocar este script. Lo cargado NO se
       bloquea: el cliente puede corregirlo. */
    var params = new URLSearchParams(location.search);
    Array.prototype.forEach.call(form.querySelectorAll('[data-sjw-req-param]'), function (el) {
      var valor = params.get(el.getAttribute('data-sjw-req-param'));
      if (valor && !el.value) el.value = valor;
    });

    /* Vehículo indicado por el cliente, como dato de apoyo. Si la ficha lo
       ha pasado por la URL, gana ese; si no, el guardado en el garaje. */
    var oculto = form.querySelector('[data-sjw-req-vehicle]');
    if (oculto) {
      var vehiculoUrl = params.get('vehiculo');
      if (vehiculoUrl) {
        oculto.value = vehiculoUrl;
      } else if (window.SJWGarage) {
        var v = window.SJWGarage.get();
        if (v) oculto.value = window.SJWGarage.label(v);
      }
    }

    if (enviado) {
      limpiar();
    } else if (restaurar()) {
      var aviso = form.querySelector('[data-sjw-req-restaurado]');
      if (aviso) aviso.hidden = false;
    }

    form.addEventListener('input', guardar);
    form.addEventListener('change', guardar);

    /* Validación propia, en el idioma de la tienda.
       El navegador escribe sus avisos en el idioma de su interfaz, no en el de
       la página, y los pinta en una burbuja que desaparece sola. Aquí el aviso
       se queda junto al campo, queda anunciado por `aria-describedby` y el foco
       va al primero que falla. Si este script no llega a ejecutarse, el
       navegador sigue validando como siempre: `novalidate` se pone desde aquí. */
    var TEXTOS = {
      requerido: {{ 'sjw.request.err_required' | t | json }},
      correo:    {{ 'sjw.request.err_email' | t | json }}
    };

    function huecoDeError(el) {
      var id = el.id + '-error';
      var hueco = document.getElementById(id);
      if (!hueco) {
        hueco = document.createElement('span');
        hueco.className = 'sjw-field-error';
        hueco.id = id;
        hueco.hidden = true;
        el.parentNode.appendChild(hueco);
      }
      return hueco;
    }

    function describir(el, id, poner) {
      var lista = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter(Boolean);
      var i = lista.indexOf(id);
      if (poner && i === -1) lista.push(id);
      if (!poner && i !== -1) lista.splice(i, 1);
      if (lista.length) el.setAttribute('aria-describedby', lista.join(' '));
      else el.removeAttribute('aria-describedby');
    }

    function limpiarError(el) {
      var hueco = document.getElementById(el.id + '-error');
      if (hueco) { hueco.hidden = true; hueco.textContent = ''; }
      el.removeAttribute('aria-invalid');
      describir(el, el.id + '-error', false);
    }

    function marcarError(el) {
      var hueco = huecoDeError(el);
      hueco.textContent = el.validity.typeMismatch ? TEXTOS.correo : TEXTOS.requerido;
      hueco.hidden = false;
      el.setAttribute('aria-invalid', 'true');
      describir(el, hueco.id, true);
    }

    campos().forEach(function (el) {
      el.addEventListener('blur', function () {
        if (!el.willValidate) return;
        if (el.checkValidity()) limpiarError(el);
        else if (el.value) marcarError(el);
      });
      el.addEventListener('input', function () {
        if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity()) limpiarError(el);
      });
    });

    form.setAttribute('novalidate', 'novalidate');

    form.addEventListener('submit', function (evento) {
      var fallan = campos().filter(function (el) { return el.willValidate && !el.checkValidity(); });
      campos().forEach(function (el) { if (fallan.indexOf(el) === -1) limpiarError(el); });
      fallan.forEach(marcarError);
      if (fallan.length) {
        evento.preventDefault();
        fallan[0].focus();
      }
    });

    /* El foco va al mensaje que explica qué ha pasado. */
    var ok = form.querySelector('[data-sjw-req-ok]');
    var mal = form.querySelector('[data-sjw-req-error]');
    if (ok) ok.focus();
    else if (mal) mal.focus();
  })();
</script>

{% schema %}
{
  "name": "Solicitud compatibilidad",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Cuéntanos tu vehículo y lo comprobamos" },
    { "type": "textarea", "id": "intro", "label": "Introducción",
      "default": "Si tu coche no está en el buscador, o una llanta aparece como «Necesita confirmación técnica», escríbenos con estos datos y te respondemos." },
    { "type": "checkbox", "id": "usar_h1", "label": "El título es el H1 de la página", "default": true },
    { "type": "checkbox", "id": "mostrar_motivo", "label": "Mostrar «Motivo de la consulta»", "default": false,
      "info": "Actívalo en la página de contacto general. En la de compatibilidad sobra." },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#090A0C" }
  ],
  "presets": [{ "name": "Solicitud compatibilidad" }]
}
{% endschema %}
