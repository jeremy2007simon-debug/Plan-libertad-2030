{%- comment -%}
  SJ Wheels — Solicitud manual de compatibilidad.

  Mientras no haya vehículos verificados en la base, TODO el catálogo está en
  "Necesita confirmación técnica" y esta es la única vía real del cliente.
  Por eso el formulario no puede depender de WhatsApp ni de ninguna app: usa
  {% form 'contact' %}, que es nativo de Shopify y funciona sin instalar nada.

  El texto no promete una comprobación que no se hace: la revisión técnica es
  de una persona y no se limita a PCD, diámetro, ET y buje.
{%- endcomment -%}

{% render 'sjw-strings' %}

{%- liquid
  assign titulo = section.settings.heading
  assign intro  = section.settings.intro
-%}

<section class="sjw-root sjw-section" style="background: {{ section.settings.background_color }};">
  <div class="sjw-container sjw-req">
    <div class="sjw-req__intro">
      <p class="sjw-eyebrow">{{ 'sjw.request.eyebrow' | t }}</p>
      <h2 class="sjw-h2">{{ titulo }}</h2>
      {% if intro != blank %}<p class="sjw-lead">{{ intro }}</p>{% endif %}

      <div class="sjw-note sjw-note--info">
        <span class="sjw-note__icon" aria-hidden="true">i</span>
        <div>
          <strong>{{ 'sjw.request.what_we_check' | t }}</strong>
          <p class="sjw-small">{{ 'sjw.request.what_we_check_body' | t }}</p>
        </div>
      </div>
    </div>

    {% form 'contact', class: 'sjw-req__form', id: 'sjw-fitment-request' %}
      {%- if form.posted_successfully? -%}
        <div class="sjw-note sjw-note--ok" role="status" tabindex="-1" data-sjw-req-ok>
          <span class="sjw-note__icon" aria-hidden="true">✓</span>
          <div>
            <strong>{{ 'sjw.request.sent_title' | t }}</strong>
            <p class="sjw-small">{{ 'sjw.request.sent_body' | t }}</p>
          </div>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="sjw-note sjw-note--error" role="alert" tabindex="-1">
          <span class="sjw-note__icon" aria-hidden="true">✕</span>
          <div>
            <strong>{{ 'sjw.request.error_title' | t }}</strong>
            <ul class="sjw-small">
              {%- for campo in form.errors -%}
                <li>{{ form.errors.messages[campo] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      <div class="sjw-req__grid">
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-nombre">{{ 'sjw.request.name' | t }}</label>
          <input class="sjw-input" id="sjw-req-nombre" type="text" name="contact[name]"
                 autocomplete="name" required value="{{ form.name }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-email">{{ 'sjw.request.email' | t }}</label>
          <input class="sjw-input" id="sjw-req-email" type="email" name="contact[email]"
                 autocomplete="email" required value="{{ form.email }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-marca">{{ 'sjw.request.make_model' | t }}</label>
          <input class="sjw-input" id="sjw-req-marca" type="text" required
                 name="contact[Marca, modelo y generación]"
                 placeholder="{{ 'sjw.request.make_model_ph' | t }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-anio">{{ 'sjw.request.year' | t }}</label>
          <input class="sjw-input" id="sjw-req-anio" type="text" inputmode="numeric" required
                 name="contact[Año de matriculación]" placeholder="2019">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-motor">{{ 'sjw.request.engine' | t }}</label>
          <input class="sjw-input" id="sjw-req-motor" type="text"
                 name="contact[Motorización o versión]" placeholder="{{ 'sjw.request.engine_ph' | t }}">
        </p>
        <p class="sjw-field">
          <label class="sjw-label" for="sjw-req-actual">{{ 'sjw.request.current_size' | t }}</label>
          <input class="sjw-input" id="sjw-req-actual" type="text"
                 name="contact[Medida montada actualmente]" placeholder="{{ 'sjw.request.current_size_ph' | t }}">
        </p>
        <p class="sjw-field sjw-req__wide">
          <label class="sjw-label" for="sjw-req-ref">{{ 'sjw.request.reference' | t }}</label>
          <input class="sjw-input" id="sjw-req-ref" type="text"
                 name="contact[Referencia de la llanta]" data-sjw-req-reference
                 placeholder="{{ 'sjw.request.reference_ph' | t }}">
          <span class="sjw-small">{{ 'sjw.request.reference_help' | t }}</span>
        </p>
        <p class="sjw-field sjw-req__wide">
          <label class="sjw-label" for="sjw-req-msg">{{ 'sjw.request.message' | t }}</label>
          <textarea class="sjw-input sjw-req__area" id="sjw-req-msg" rows="4"
                    name="contact[body]" placeholder="{{ 'sjw.request.message_ph' | t }}"></textarea>
        </p>
      </div>

      {%- comment -%}
        Lo que el navegador sabe del vehículo guardado se envía como dato de
        apoyo, marcado como indicado por el cliente. No es una verificación.
      {%- endcomment -%}
      <input type="hidden" name="contact[Vehículo guardado en la web (indicado por el cliente)]"
             data-sjw-req-vehicle value="">

      <div class="sjw-req__actions">
        <button class="sjw-btn sjw-btn--primary" type="submit">{{ 'sjw.request.submit' | t }}</button>
        <span class="sjw-small">{{ 'sjw.request.privacy' | t }}</span>
      </div>
    {% endform %}
  </div>
</section>

<script>
  /* Rellena la referencia desde ?ref= y el vehículo desde el garaje local.
     Ambos campos quedan marcados como dato indicado por el cliente. */
  (function () {
    var ref = new URLSearchParams(location.search).get('ref');
    if (ref) {
      var campo = document.querySelector('[data-sjw-req-reference]');
      if (campo && !campo.value) campo.value = ref;
    }
    var oculto = document.querySelector('[data-sjw-req-vehicle]');
    if (oculto && window.SJWGarage) {
      var v = window.SJWGarage.get();
      if (v) oculto.value = window.SJWGarage.label(v);
    }
    var ok = document.querySelector('[data-sjw-req-ok]');
    if (ok) ok.focus();
  })();
</script>

<style>
  .sjw-req { display: grid; gap: var(--sjw-s6); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 900px) { .sjw-req { grid-template-columns: 22rem minmax(0, 1fr); gap: var(--sjw-s7); } }
  .sjw-req__intro { display: grid; gap: var(--sjw-s3); }
  .sjw-req__form { display: grid; gap: var(--sjw-s4); }
  .sjw-req__grid { display: grid; gap: var(--sjw-s3); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .sjw-req__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sjw-req__wide { grid-column: 1 / -1; }
  .sjw-req__area { min-height: 7rem; padding-block: var(--sjw-s3); resize: vertical; }
  .sjw-req__actions { display: flex; flex-wrap: wrap; gap: var(--sjw-s3); align-items: center; }
</style>

{% schema %}
{
  "name": "Solicitud compatibilidad",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Cuéntanos tu vehículo y lo comprobamos" },
    { "type": "textarea", "id": "intro", "label": "Introducción",
      "default": "Si tu coche no está en el buscador, o una llanta aparece como «Necesita confirmación técnica», escríbenos con estos datos y te respondemos." },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#090A0C" }
  ],
  "presets": [{ "name": "Solicitud compatibilidad" }]
}
{% endschema %}
