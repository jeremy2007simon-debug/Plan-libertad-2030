{%- comment -%}
  SJ Wheels — Preguntas frecuentes.
  Emite datos estructurados FAQPage solo cuando hay preguntas reales escritas.
{%- endcomment -%}
{%- comment -%}
  Los estilos van antes del marcado: con la hoja al final, el navegador puede
  llegar a pintar la sección sin ella y la página da un salto cuando aparece.
  Medido en la solicitud de compatibilidad: 36 px de desplazamiento (CLS 0,138).
{%- endcomment -%}
<style>
  .sjw-faq { display: grid; gap: var(--sjw-s5); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 900px) { .sjw-faq { grid-template-columns: 22rem minmax(0, 1fr); gap: var(--sjw-s7); } }
  .sjw-faq .sjw-lead { margin-top: var(--sjw-s2); }
</style>

<section class="sjw-root sjw-section" style="background: {{ section.settings.background_color }};"
         aria-labelledby="sjw-faq-{{ section.id }}">
  <div class="sjw-container sjw-faq">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="sjw-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sjw-h2" id="sjw-faq-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="sjw-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <sjw-accordion class="sjw-acc" single>
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          <div class="sjw-acc__item" {{ block.shopify_attributes }}>
            <h3>
              <button type="button" class="sjw-acc__head"
                      aria-expanded="false" aria-controls="sjw-faq-p-{{ block.id }}"
                      id="sjw-faq-h-{{ block.id }}">
                <span>{{ block.settings.question }}</span>
                <span class="sjw-acc__sign" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="sjw-acc__panel" id="sjw-faq-p-{{ block.id }}" role="region"
                 aria-labelledby="sjw-faq-h-{{ block.id }}" hidden>
              <div class="sjw-body">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </sjw-accordion>
  </div>
</section>

{%- liquid
  assign faq_count = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign faq_count = faq_count | plus: 1
    endif
  endfor
-%}
{%- if faq_count > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- assign i = i | plus: 1 -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{%- unless i == faq_count -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}


<script src="{{ 'sjw-accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "tag": "section",
  "blocks": [
    { "type": "faq", "name": "Pregunta", "settings": [
      { "type": "text", "id": "question", "label": "Pregunta" },
      { "type": "richtext", "id": "answer", "label": "Respuesta" }
    ]}
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Dudas frecuentes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#090A0C" }
  ],
  "presets": [{
    "name": "Preguntas frecuentes",
    "blocks": [
      { "type": "faq", "settings": { "question": "¿El precio es por llanta o por juego?",
        "answer": "<p>Salvo que la ficha del producto indique lo contrario, el precio corresponde al juego completo de 4 llantas.</p>" } },
      { "type": "faq", "settings": { "question": "¿Los neumáticos están incluidos?",
        "answer": "<p>No. Los neumáticos no están incluidos salvo que la ficha del producto lo indique expresamente.</p>" } },
      { "type": "faq", "settings": { "question": "¿Cómo sé que las llantas encajan en mi coche?",
        "answer": "<p>Selecciona tu vehículo y verás el estado de compatibilidad de cada llanta. Comparamos PCD, diámetro, ET y buje central. Además revisamos la compatibilidad una última vez antes del envío.</p>" } },
      { "type": "faq", "settings": { "question": "¿Qué significa «Necesita confirmación técnica»?",
        "answer": "<p>Que todavía no tenemos verificada esa combinación concreta de llanta y vehículo. Puedes escribirnos y lo comprobamos contigo antes de que compres.</p>" } }
    ]
  }]
}
{% endschema %}
