{%- comment -%}
  sjw-consultar-disponibilidad.liquid
  Tema: SJ Wheels — DEV (no publicar).

  Sustituye el formulario de compra por el estado «Consultar disponibilidad y
  compatibilidad» mientras el producto no tenga disponibilidad confirmada o
  compatibilidad verificada.

  Dónde va: en la plantilla de producto, envolviendo el bloque de compra.

    {%- render 'sjw-consultar-disponibilidad', product: product -%}
    {%- unless product.metafields.custom.availability_status or
                product.metafields.custom.requires_manual_verification -%}
      {%- comment -%} aquí el formulario de compra normal {%- endcomment -%}
    {%- endunless -%}

  Ajusta FORM_URL a la página real de consulta antes de usarlo.
{%- endcomment -%}

{%- assign form_url = '/pages/consulta-disponibilidad' -%}
{%- assign estado = product.metafields.custom.availability_status | default: '' -%}
{%- assign verificar = product.metafields.custom.requires_manual_verification -%}

{%- if estado != '' or verificar -%}
  <div class="sjw-consulta" role="status">
    <p class="sjw-consulta__estado"><strong>Consultar disponibilidad y compatibilidad</strong></p>

    <ul class="sjw-consulta__motivos">
      {%- if estado != '' -%}
        <li>Disponibilidad: {{ estado }}</li>
      {%- endif -%}
      {%- if verificar -%}
        <li>Compatibilidad: SJ Wheels debe verificar la medida y la configuración del vehículo antes del montaje.</li>
      {%- endif -%}
      {%- if product.metafields.custom.set_contents_status != blank -%}
        <li>Contenido del pedido: {{ product.metafields.custom.set_contents_status }}</li>
      {%- endif -%}
    </ul>

    <a class="sjw-consulta__cta button"
       href="{{ form_url }}?ref={{ product.selected_or_first_available_variant.sku | url_encode }}&amp;medida={{ product.metafields.custom.wheel_diameter }}x{{ product.metafields.custom.wheel_width }}&amp;anclaje={{ product.metafields.custom.bolt_pattern | url_encode }}">
      Consultar esta referencia
    </a>

    <p class="sjw-consulta__aviso">
      No se acepta ningún pedido hasta que SJ Wheels confirme por escrito la
      disponibilidad y la compatibilidad. Una confirmación del cliente no
      sustituye a esa comprobación.
    </p>
  </div>
{%- endif -%}
